<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Canvas">#0B0F16</Color>
  <Color x:Key="Sidebar">#111722</Color>
  <Color x:Key="Panel">#151C28</Color>
  <Color x:Key="PanelHover">#1A2432</Color>
  <Color x:Key="Text">#F5F7FA</Color>
  <Color x:Key="Muted">#98A5B8</Color>
  <Color x:Key="Accent">#59E1B5</Color>
  <Color x:Key="Line">#293547</Color>
  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Canvas}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource Sidebar}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}" />
  <SolidColorBrush x:Key="PanelHoverBrush" Color="{StaticResource PanelHover}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}" />
</ResourceDictionary>
