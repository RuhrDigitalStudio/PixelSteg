<Window x:Class="PixelSteg.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PixelSteg" Width="760" Height="560" MinWidth="620" MinHeight="470" AllowDrop="True" Drop="OnDrop">
  <Grid Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="PixelSteg" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="A transparent, inert file-to-PNG container" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,24"/>
      <StackPanel Orientation="Horizontal"><Button Content="Encode" Click="EncodeModeClick"/><Button Content="Decode" Click="DecodeModeClick"/></StackPanel></StackPanel>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="28" Margin="0,24"><StackPanel>
      <TextBlock Text="{Binding InputHint}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Drop a file here or use Browse." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
      <DockPanel><Button Content="Browse" Click="BrowseInputClick" DockPanel.Dock="Right"/><TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" VerticalContentAlignment="Center"/></DockPanel>
      <TextBlock Text="Destination" FontWeight="SemiBold" Margin="0,22,0,8"/><DockPanel><Button Content="Choose" Click="BrowseDestinationClick" DockPanel.Dock="Right"/><TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" VerticalContentAlignment="Center"/></DockPanel>
      <ProgressBar Height="8" Margin="0,26,0,8" Maximum="100" Value="{Binding Progress}"/><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding OriginalFileName, StringFormat=Original embedded name: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelClick" IsEnabled="{Binding IsBusy}" Background="#CF6B73" Foreground="White"/><Button Content="{Binding ActionLabel}" Click="RunClick" IsEnabled="{Binding CanStart}"/></StackPanel>
  </Grid>
</Window>
